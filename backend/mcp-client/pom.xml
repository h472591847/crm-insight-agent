<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 默认打包方式 -->
    <packaging>jar</packaging>

    <parent>
        <groupId>com.github.yingli</groupId>
        <artifactId>SpringAi-MCP-RAG-Dev</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>mcp-client</artifactId>

    <properties>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- 公共资源模块（提供 classpath:logback-plus.xml） -->
        <dependency>
            <groupId>com.github.yingli</groupId>
            <artifactId>mcp-common</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 运行时指标：Actuator 暴露 /actuator/metrics，用于现场排查 SSE 通道指标。
             不引入 Prometheus registry——公司没有 Prometheus 抓取方，指标只做本地可查 + 日志输出。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 注：spring-boot-starter-aop / spring-boot-starter-test / lombok / commons-lang3
             已上移到父级 backend/pom.xml 的 <dependencies>，这里不再重复声明 -->

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-advisors-vector-store</artifactId>
        </dependency>
        <!-- Spring AI - Redis 向量数据库存储模块（可选依赖）
             测试环境无 Redis Stack → application.yml 里 vectorstore.redis.enabled=false 关自动装配 + @Profile("!test") 关 RAG 组件
             生产需要时：enabled=true + 去掉 @Profile 限制 + 重建 Redis 向量索引 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-redis</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 不使用本地跑嵌入模型‌ , 所以暂不引入-->
<!--        <dependency>-->
<!--            <groupId>org.springframework.ai</groupId>-->
<!--            <artifactId>spring-ai-starter-model-transformers</artifactId>-->
<!--        </dependency>-->

        <!-- Spring AI - Tika 文档解析模块（PDF、DOCX 等） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-tika-document-reader</artifactId>
        </dependency>

        <!-- Spring AI - Markdown 文档读取模块 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-markdown-document-reader</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-mcp</artifactId>
        </dependency>
        <!-- OkHttp HTTP 客户端 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>

        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy-json</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>

        <!-- OpenAI 兼容端点接入（ChatModel + EmbeddingModel） -->
        <!-- 百炼 MaaS 专属 endpoint 只支持 OpenAI 兼容端点 /compatible-mode/v1/*，不支持 DashScope 原生 API -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- 引入dotenv依赖 -->
        <dependency>
            <groupId>io.github.cdimascio</groupId>
            <artifactId>dotenv-java</artifactId>
        </dependency>

        <!-- Redisson 分布式锁：只引入核心库 + Spring Data 适配器，手动写 RedissonClient bean。
             不使用 redisson-spring-boot-starter——它会覆盖 Spring Boot 原生 RedisConnectionFactory/RedisTemplate，
             导致 Spring AI RedisVectorStore（FT.CREATE/FT.SEARCH 等命令）和我们手写的 RedisChatMemoryRepository 失效。 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>

    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>